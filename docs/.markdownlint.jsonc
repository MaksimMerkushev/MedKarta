// Правила markdownlint для docs/ (проверка: npx markdownlint-cli "docs/**/*.md").
{
  "default": true,
  // Длинные строки в таблицах и ссылках — норма для технической документации.
  "MD013": false,
  // Одинаковые заголовки допустимы в разных разделах («Ограничения», «Тесты»).
  "MD024": { "siblings_only": true },
  // _sidebar.md docsify не начинается с заголовка.
  "MD041": false,
  // Встроенный HTML в документах не используется, но <br/> встречается в подписях диаграмм внутри блоков кода.
  "MD033": false,
  // Стиль списков и выделения — как в существующих документах проекта.
  "MD004": false,
  "MD007": false,
  "MD029": false,
  "MD049": false,
  "MD050": false,
  // Строка-разделитель таблиц «|---|---|» — стиль всего репозитория.
  "MD060": false
}
