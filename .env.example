# Скопируйте этот файл в .env и подставьте реальное значение локально.
# .env закоммичен быть не должен — он в .gitignore.
#
# ВАЖНО: у переменной НЕТ префикса VITE_ — и это принципиально.
# Всё, что начинается на VITE_, Vite подставляет прямо в JS-бандл,
# то есть значение становится видно любому посетителю сайта.
# Ключ читает только серверная функция api/chat.js.

OPENROUTER_API_KEY=

# Необязательно: переопределение апстрима и модели.
# ВНИМАНИЕ: без AI_UPSTREAM_URL запросы (и ключ) уходят на modelhub.my.
# Для ключа OpenRouter задайте его адрес явно:
# AI_UPSTREAM_URL=https://openrouter.ai/api/v1/chat/completions
# AI_MODEL=gpt-5.4-mini

# Необязательно: список доверенных Origin через запятую,
# если фронтенд живёт на домене, отличном от домена функции.
# ALLOWED_ORIGINS=https://medkarta.example

# Необязательно, но рекомендуется: имена хоста, на которые отвечает API
# (защита от DNS rebinding). Например: medkarta.example,www.medkarta.example
# ALLOWED_HOSTS=medkarta.example

# --- Privacy / AI слой ---------------------------------------------------
# См. docs/privacy-architecture.md

# Секрет для вывода ключей Token Vault. Не менее 16 символов.
# Если не задан, берётся случайный секрет процесса: соответствия токенов
# не переживают рестарт — менее удобно, но безопаснее предсказуемого ключа.
PRIVACY_TOKEN_SECRET=

# Время жизни соответствия «токен → сущность», секунды. По умолчанию 900.
# PRIVACY_TOKEN_TTL_SECONDS=900

# Хранилище токенов: memory (по умолчанию) либо upstash.
# memory живёт в памяти инстанса и не переживает рестарт и несколько
# инстансов — для продакшена нужен внешний стор.
# TOKEN_VAULT_BACKEND=upstash
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Маршрутизация. По умолчанию local — собственный движок на собранном графе
# (см. docs/routing.md). Если графа нет, автоматически используется оценка
# по прямой, приложение продолжает работать.
# ROUTING_PROVIDER=local
# ROUTING_GRAPH_PATH=data/graph/kazan.graph
#
# haversine — всегда по прямой, граф не нужен.
# osrm — сторонний сервер. ВНИМАНИЕ: это передача координат пользователя
# третьей стороне, её нужно отражать в политике конфиденциальности.
# ROUTING_OSRM_URL=https://routing.example/osrm

# Разрешить клиенту присылать огрублённую точку отправления (2 знака, ~1.1 км)
# для предварительного отбора кандидатов на сервере. По умолчанию выключено:
# расстояния считаются в браузере и координаты не покидают устройство.
# Во внешнюю модель координаты не передаются ни при каком значении.
# ALLOW_COARSE_ORIGIN=on

# Не загружать справочник учреждений (ускоряет холодный старт, ухудшает
# распознавание названий клиник).
# PRIVACY_CATALOG_FACILITIES=off

# --- Сервер ---------------------------------------------------------------
# Сколько прокси стоит перед сервером (nginx — 1). Только тогда адрес клиента
# для ограничения частоты берётся из X-Forwarded-For. Без прокси оставьте 0:
# иначе клиент подставит любой адрес и обойдёт лимит.
# TRUST_PROXY=1

# Потолок одновременных соединений. На VPS с одним ядром больше не нужно.
# MAX_CONNECTIONS=512
# Потолок соединений с одного адреса (только без прокси, TRUST_PROXY=0).
# MAX_CONNECTIONS_PER_IP=32

# --- Продуктовая аналитика -------------------------------------------------
# См. docs/analytics.md. События — только перечислимые значения: без текста
# поиска, координат и IP. Журнал — файлы JSON Lines по дням.
# ANALYTICS=off                          # выключить запись событий совсем
# ANALYTICS_DIR=/var/lib/medkarta/analytics  # по умолчанию var/analytics в проекте
# ANALYTICS_RETENTION_DAYS=180           # сколько дней хранить файлы
# ANALYTICS_MAX_EVENTS_PER_DAY=200000    # потолок записей в сутки (защита диска)
